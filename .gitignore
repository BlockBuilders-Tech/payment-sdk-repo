# Ignore everything by default
*

# Keep basic repo files
!README.md
!.gitignore
!codemagic.yaml
!pubspec.yaml
!pubspec.lock
!analysis_options.yaml
!.metadata

# Keep Flutter source
!lib/
!lib/**
!test/
!test/**

# Keep platform source needed for builds
!ios/
!ios/**
!android/
!android/**

# Keep published Android AAR Maven repo if needed
!repo/
!repo/**

# Ignore generated/local files
.dart_tool/
.pub/
build/
.android/
.ios/
.flutter-plugins
.flutter-plugins-dependencies

# IDE files
.idea/
*.iml

# macOS/temp
.DS_Store
Icon?
*.pyc
*.swp
*.log

# Xcode local files
DerivedData/
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Flutter symbols/maps
app.*.symbols
app.*.map.json